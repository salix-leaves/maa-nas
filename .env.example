# 复制成 .env 后按你的环境修改：  cp .env.example .env
TZ=Asia/Shanghai

# ===== 目标 PC / 模拟器 =====
MAA_ADB_ADDRESS=192.168.1.100:16384
MAA_PC_SSH=你的Windows用户名@192.168.1.100
MAA_MUMU_MANAGER=D:\MuMuPlayer-12.0\nx_main\MuMuManager.exe
MAA_PC_TASK=MAA-StartMuMu
MAA_MUMU_INDEX=0
MAA_GAME_PKG=com.hypergryph.arknights
MAA_WAIT_SECS=180

# ===== Web 手动开关 =====
MAA_WEB_PASSWORD=请改成你自己的密码
# 只让本机访问用 127.0.0.1；想让局域网其他设备访问就填 NAS 的局域网 IP
BIND_IP=127.0.0.1

# ===== 定时（off = 关闭，只用手动开关）=====
MAA_CRON_TIME=off
MAA_TASK=daily

# ===== SSH 私钥目录（NAS 上的，容器只读挂载）=====
SSH_DIR=/root/.ssh
